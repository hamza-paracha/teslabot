{
  "name": "teslabot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "routes": [{ "pattern": "tesla.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "TESLA_REGION": "na",
    "ENABLE_LOCATION": "false",
    "ENABLE_VEHICLE_COMMANDS": "false",
    "ALLOW_VEHICLE_WAKE": "false",
    "MAX_REQUESTS_PER_DAY": "50",
    "MAX_ESTIMATED_MONTHLY_SPEND_USD": "5",
    "CACHE_TTL_SECONDS": "300",
    "APP_ORIGIN": "https://tesla.example.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teslabot-production",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": false,
  },
}
